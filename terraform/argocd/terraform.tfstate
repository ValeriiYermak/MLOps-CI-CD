            "metadata": [
              {
                "app_version": "v2.13.2",
                "chart": "argo-cd",
                "first_deployed": 1788109253,
                "last_deployed": 1788109253,
                "name": "argocd",
                "namespace": "infra-tools",
                "notes": "In order to access the server UI you have the following options:\n\n1. kubectl port-forward service/argocd-server -n infra-tools 8080:443\n\n    and then open the browser on http://localhost:8080 and accept the certificate\n\n2. enable ingress in the values file `server.ingress.enabled` and either\n      - Add the annotation for ssl passthrough: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-1-ssl-passthrough\n      - Set the `configs.params.\"server.insecure\"` in the values file and terminate SSL at your ingress: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-2-multiple-ingress-objects-and-hosts\n\n\nAfter reaching the UI the first time you can login with username: admin and the random password generated during the installation. You can find the password by running:\n\nkubectl -n infra-tools get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d\n\n(You should delete the initial secret afterwards as suggested by the Getting Started Guide: https://argo-cd.readthedocs.io/en/stable/getting_started/#4-login-using-the-cli)\n",
                "revision": 1,
                "values": "{\"configs\":{\"rbac\":{\"policy.csv\":\"p, role:admin, applications, *, */*, allow\\np, role:admin, clusters, *, *, allow\\np, role:admin, repositories, *, *, allow\\ng, admin, role:admin\\n\",\"policy.default\":\"role:readonly\"}},\"controller\":{\"args\":{\"appResyncPeriod\":\"60\"},\"resources\":{\"limits\":{\"cpu\":\"500m\",\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"256Mi\"}}},\"dex\":{\"enabled\":false},\"global\":{\"revisionHistoryLimit\":5},\"notifications\":{\"enabled\":false},\"server\":{\"extraArgs\":[\"--insecure\"],\"service\":{\"type\":\"ClusterIP\"}}}",
                "version": "7.7.11"
              }
            ],
            "name": "argocd",
            "namespace": "infra-tools",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://argoproj.github.io/argo-helm",
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "# argocd-values.yaml\r\n# Кастомні налаштування для офіційного Helm-чарту argo-cd\r\n\r\n# --- Вимикаємо необов'язкові компоненти для економії ресурсів ---\r\n# У навчальному кластері на t3.micro нодах діє жорсткий ліміт кількості\r\n# подів на ноду (обмеження ENI для AWS VPC CNI, ~4 поди/нода). Dex (SSO)\r\n# та Notifications Controller не використовуються в цьому завданні,\r\n# тому вимикаємо їх, щоб звільнити місце для основних компонентів.\r\ndex:\r\n  enabled: false\r\n\r\nnotifications:\r\n  enabled: false\r\n\r\n# --- Налаштування Argo CD Server (компонент з Web UI та API) ---\r\nserver:\r\n  service:\r\n    type: ClusterIP\r\n\r\n  extraArgs:\r\n    - --insecure\r\n\r\n# --- RBAC (Role-Based Access Control) для самого Argo CD ---\r\nconfigs:\r\n  rbac:\r\n    policy.default: role:readonly\r\n\r\n    policy.csv: |\r\n      p, role:admin, applications, *, */*, allow\r\n      p, role:admin, clusters, *, *, allow\r\n      p, role:admin, repositories, *, *, allow\r\n      g, admin, role:admin\r\n\r\n# --- Таймаути для контролерів Argo CD ---\r\ncontroller:\r\n  args:\r\n    appResyncPeriod: \"60\"\r\n\r\n  resources:\r\n    requests:\r\n      cpu: 100m\r\n      memory: 256Mi\r\n    limits:\r\n      cpu: 500m\r\n      memory: 512Mi\r\n\r\n# --- Таймаути на рівні Helm-операцій (встановлення/оновлення) ---\r\nglobal:\r\n  revisionHistoryLimit: 5"
            ],
            "verify": false,
            "version": "7.7.11",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
